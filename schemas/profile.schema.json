{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "language", "description", "target_size_gb", "disk_budget_gb"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "title": { "type": "string" },
    "language": { "enum": ["en", "es", "both"] },
    "variant": { "enum": ["english", "spanish", "bilingual"] },
    "description": { "type": "string" },
    "target_size_gb": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "disk_budget_gb": { "type": "number" },
    "includes": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "models": { "type": "object" }
  }
}
